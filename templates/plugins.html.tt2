<!DOCTYPE html>
<html>
<head>
	<title>[% title %] - [% c.lh("Plugin Configuration") %]</title>

	<meta name="viewport" content="width=device-width" />
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<meta name="apple-mobile-web-status-bar-style" content="black" />
	<meta name="mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-capable" content="yes" />

	<link type="image/png" rel="icon" href="/favicon.ico" />
	<link rel="manifest" href="app.webappmanifest" />
	<link rel="stylesheet" type="text/css" href="[% c.url_for("/css/lrr.css?$version") %]" />
	<link rel="stylesheet" type="text/css" href="[% c.url_for("/css/config.css?$version") %]" />

	<link rel="stylesheet" type="text/css" href="[% c.url_for("/css/vendor/fontawesome-all.min.css") %]" />
	<link rel="stylesheet" type="text/css" href="[% c.url_for("/css/vendor/jquery.fileupload.css") %]" />
	<link rel="stylesheet" type="text/css" href="[% c.url_for("/css/vendor/allcollapsible.min.css") %]" />
	<link rel="stylesheet" type="text/css" href="[% c.url_for("/css/vendor/ReactToastify.min.css") %]" />
	<link rel="stylesheet" type="text/css" href="[% c.url_for("/css/vendor/sweetalert2.min.css") %]" />
	[% csshead %]

	[% INCLUDE common/importmap %]

	<script src="[% c.url_for("/js/vendor/jquery.min.js") %]" type="text/JAVASCRIPT"></script>
	<script src="[% c.url_for("/js/vendor/jquery.ui.widget.js") %]" type="text/JAVASCRIPT"></script>
	<script src="[% c.url_for("/js/vendor/jquery.fileupload.js") %]" type="text/JAVASCRIPT"></script>
	<script src="[% c.url_for("/js/vendor/allcollapsible.min.js") %]" type="text/JAVASCRIPT"></script>

	<script src="[% c.url_for("/js/plugins.js?$version") %]" type="module"></script>

</head>

<body>

	<div class="ido" style="text-align:center;">
		<h1 class="ih" style="text-align:center">[% c.lh("Plugin Configuration") %]</h1>
		<p class="plugin-subtitle">[% c.lh("Manage installed plugins and browse available plugins from registries.") %]</p>

		<div class="plugin-content">

			[%# ===== Tab bar ===== %]
			<div class="plugin-tabs">
				<button type="button" class="plugin-tab active" data-tab="tab-configure">
					<i class="fa fa-cogs"></i> [% c.lh("Configure") %]
				</button>
				<button type="button" class="plugin-tab" data-tab="tab-manage">
					<i class="fa fa-cubes"></i> [% c.lh("Manage") %]
				</button>
			</div>

			<form name="editPluginForm" id="editPluginForm" enctype="multipart/form-data" method="post">

				[%# ===== Tab: Configure Plugins ===== %]
				<div id="tab-configure" class="plugin-tab-panel active">

					<ul class="collapsible extensible with-right-caret">
						[%# ===== Login Plugins ===== %]
						<li class="option-flyout" id="section-login">
							<div class="collapsible-title caret-right">
								<i class="fa fa-plug" aria-hidden="true"></i> [% c.lh("Login Plugins") %]
							</div>
							<div class="collapsible-body">
								[% INCLUDE pluginlist plugins = logins %]
							</div>
						</li>

						[%# ===== Downloaders ===== %]
						<li class="option-flyout" id="section-download">
							<div class="collapsible-title caret-right">
								<i class="fas fa-cloud-download-alt" aria-hidden="true"></i> [% c.lh("Downloaders") %]
							</div>
							<div class="collapsible-body">
								[% INCLUDE pluginlist plugins = downloaders %]
							</div>
						</li>

						[%# ===== Scripts ===== %]
						<li class="option-flyout" id="section-script">
							<div class="collapsible-title caret-right">
								<i class="fa fa-scroll" aria-hidden="true"></i> [% c.lh("Scripts") %]
							</div>
							<div class="collapsible-body">
								[% INCLUDE pluginlist plugins = scripts %]
							</div>
						</li>

						[%# ===== Metadata Plugins ===== %]
						<li class="option-flyout" id="section-metadata">
							<div class="collapsible-title caret-right">
								<i class="fa fa-digital-tachograph" aria-hidden="true"></i> [% c.lh("Metadata Plugins") %]
							</div>
							<div class="collapsible-body">

								<label for="replacetitles" style="display:inline; font-size:9pt;">[% c.lh("Allow Plugins to replace archive titles:") %] </label>
								[% IF replacetitles %]
								<input id="replacetitles" name="replacetitles" class="fa" type="checkbox" checked> [% ELSE %]
								<input id="replacetitles" name="replacetitles" class="fa" type="checkbox"> [% END %]
								<br />
								<span style="font-size:9pt; color:#999;">[% c.lh("If enabled, metadata plugins will be able to change the title of your archives alongside adding tags to them.") %]</span>
								<br /><br />

								[% INCLUDE pluginlist plugins = metadata %]

							</div>
						</li>
					</ul>

					<br />
					<h1 style="text-align:center">
						<span class="script-running" style="display:none">
							<i aria-hidden="true" class="fa fa-3x fa-atom fa-spin"></i> <br>
							[% c.lh("A script is running...") %]
						</span>
						<input id='save' class='stdbtn' type='button' value='[% c.lh("Save Plugin Configuration") %]' />
					</h1>

				</div>

			</form>

			[%# ===== Tab: Manage Plugins ===== %]
			<div id="tab-manage" class="plugin-tab-panel">

				<div id="registry-bar" class="registry-status">
					<span id="registry-status-text"></span>
				</div>

				<h1 style="text-align:center">
					<span id="plugin-upload" class='stdbtn fileinput-button'>
						<span>[% c.lh("Upload Plugin") %]</span>
						<input type='file' name='file' multiple id='fileupload'>
					</span>
				</h1>

				<ul class="collapsible extensible with-right-caret" id="manage-sections">
					[%# Login %]
					<li class="option-flyout" id="manage-section-login">
						<div class="collapsible-title caret-right">
							<i class="fa fa-plug" aria-hidden="true"></i> [% c.lh("Login Plugins") %]
						</div>
						<div class="collapsible-body">
							[% INCLUDE managelist plugins=logins type="login" %]
						</div>
					</li>
					[%# Downloaders %]
					<li class="option-flyout" id="manage-section-download">
						<div class="collapsible-title caret-right">
							<i class="fas fa-cloud-download-alt" aria-hidden="true"></i> [% c.lh("Downloaders") %]
						</div>
						<div class="collapsible-body">
							[% INCLUDE managelist plugins=downloaders type="download" %]
						</div>
					</li>
					[%# Scripts %]
					<li class="option-flyout" id="manage-section-script">
						<div class="collapsible-title caret-right">
							<i class="fa fa-scroll" aria-hidden="true"></i> [% c.lh("Scripts") %]
						</div>
						<div class="collapsible-body">
							[% INCLUDE managelist plugins=scripts type="script" %]
						</div>
					</li>
					[%# Metadata %]
					<li class="option-flyout" id="manage-section-metadata">
						<div class="collapsible-title caret-right">
							<i class="fa fa-digital-tachograph" aria-hidden="true"></i> [% c.lh("Metadata Plugins") %]
						</div>
						<div class="collapsible-body">
							[% INCLUDE managelist plugins=metadata type="metadata" %]
						</div>
					</li>
				</ul>

					<div id="manage-apply-bar">
					<input id="manage-apply-btn" class="stdbtn" type="button" value="[% c.lh("Apply Changes") %]" />
				</div>

				<div id="available-empty" class="pool-empty-msg" style="display:none">
					<i class="fa fa-cube pool-empty-icon"></i>
					[% c.lh("No registry configured.") %]
					<br />
					<a href="[% c.url_for("/config") %]">[% c.lh("Add one in Settings.") %]</a>
				</div>

			</div>

			<h1 style="text-align:center">
				<input id='return' class='stdbtn' type='button' value='[% c.lh("Return to Library") %]' />
			</h1>

		</div>
	</div>
	[% INCLUDE footer %]
</body>

</html>

[%# ===== Standard plugin list block ===== %]
[% BLOCK pluginlist %]

[% IF plugins.size == 0 %]
<div class="pool-empty-msg" data-type-empty="1">
	<i class="fa fa-puzzle-piece pool-empty-icon"></i>
	[% c.lh("No plugins installed.") %]
	<br />
	<a href="#tab-manage" onclick="Plugins.activateTab('tab-manage'); return false;">[% c.lh("Browse available plugins") %]</a>
</div>
[% END %]

[% FOREACH plugin IN plugins %]
<div class="pluginlist-item plugin-card" data-namespace="[% plugin.namespace %]">

	<div style="display:flex; align-items:center;">
		<div style="flex:1;">
			[% IF plugin.icon %]
			<img height=20 width=20 src="[% plugin.icon %]" />
			[% ELSE %]
			<i class="fa fa-puzzle-piece" style="font-size:20px"></i>
			[% END %]
			<h2 class="ih" style="display:inline"> [% plugin.name %] v.[% plugin.version %]</h2>
			<h1 class="ih" style="display:inline"> by [% plugin.author %] </h1>
			<span class="plugin-badge plugin-badge--[% plugin.source %]">[% plugin.source %]</span>
		</div>
		[% IF plugin.type == "metadata" %]
		<div style="text-align:right;">
			<label for="[% plugin.namespace %]" style="font-size:9pt;">[% c.lh("Run Automatically") %]</label>
			<input id="[% plugin.namespace %]" name="[% plugin.namespace %]" class="fa" type="checkbox" [% IF plugin.enabled %]checked[% END %]>
		</div>
		[% END %]
	</div>

	[% IF plugin.login_from %]
	<div style="text-align:right;">
		<i class="fa fa-plug" aria-hidden="true"></i> [% c.lh("Depends on") %] "[% plugin.login_from %]"
	</div>
	[% END %]

	[% IF plugin.type == "download" %]
	<pre title="[% c.lh("This plugin will trigger on URLs matching this regex!") %]">	[% plugin.url_regex %]</pre>
	[% END %]
	<div class="plugin-description">[% plugin.description | html %]</div>
	<span class="plugin-description-toggle">[% c.lh("Show more") %]</span>

	[% IF plugin.type == "script" %]
	<table>
		<tbody>
			[% IF plugin.oneshot_arg %]
			<tr>
				<td style="vertical-align:middle">
					<b> [% plugin.oneshot_arg %] : </b>
				</td>
				<td>
					<input style="max-width:200px" size="20" id="[% plugin.namespace %]_ARG" />
					<br />
				</td>
			</tr>
			[% END %]
			<tr>
				<td colspan="2">
					<input class='stdbtn' type='button' onclick="Server.triggerScript('[% plugin.namespace %]');"
						value='[% c.lh("Trigger Script") %]' />
				</td>
			</tr>
		</tbody>
	</table>
	[% END %]

	[% IF plugin.parameters && plugin.parameters.size %]
	<div class="collapsible-title" style="padding: 5px 0 0 5px">
		<a>
			<i class="fas fa-sliders-h" style="margin-right: 4px" aria-hidden="true"></i>
			<b>[% c.lh("Plugin Settings") %]</b>
		</a>
	</div>
	<div class="collapsible-body" style="padding:5px 0 0 0">
		<table>
			<tbody>
				[% FOREACH param IN plugin.parameters %]
				<tr>
					<td style="vertical-align:middle">
						<b> [% param.desc %] : </b>
					</td>
					<td>
						<input style="max-width:200px" size="20" name="[% plugin.namespace %]_CFG_[% IF param.exists('name') %][% param.name %][% ELSE %][% loop.count %][% END %]"
							type=[% SWITCH param.type %] [% CASE 'string' %] "text"
							value="[% param.value | html %]" class="stdinput" [% CASE 'bool' %] "checkbox" value="1" class="fa"
							[% IF param.value %] checked [% END %] [% CASE 'int' %] "number" value="[% param.value | html %]"
							class="stdinput" [% CASE %] "color" [% END %] />
						<br />
					</td>
				</tr>
				[% END %]
			</tbody>
		</table>
	</div>
	[% END %]

</div>
[% END %]

[% END %]

[%# ===== Manage tab plugin list block (installed + available per type) ===== %]
[% BLOCK managelist %]

<div class="manage-installed" data-type="[% type %]">
	[% FOREACH plugin IN plugins %]
	<div class="pluginlist-item manage-plugin-row
		[% IF plugin.source == 'builtin' %]manage-row--locked[% END %]"
		data-namespace="[% plugin.namespace %]" data-source="[% plugin.source %]" data-installed="1">
		<div style="display:flex; align-items:center;">
			<div style="flex:1;">
				[% IF plugin.icon %]
				<img height=20 width=20 src="[% plugin.icon %]" />
				[% ELSE %]
				<i class="fa fa-puzzle-piece" style="font-size:20px"></i>
				[% END %]
				<h2 class="ih" style="display:inline"> [% plugin.name %] v.[% plugin.version %]</h2>
				<h1 class="ih" style="display:inline"> by [% plugin.author %] </h1>
				<span class="plugin-badge plugin-badge--[% plugin.source %]">[% plugin.source %]</span>
			</div>
			[% IF plugin.source == 'managed' %]
			<input type="checkbox" class="fa manage-install-cb" data-namespace="[% plugin.namespace %]" data-state-label="Installed" checked />
			[% END %]
		</div>
		<div class="plugin-description">[% plugin.description | html %]</div>
	</div>
	[% END %]
</div>

<div class="manage-available" data-type="[% type %]">
	[%# Filled by JS from registry %]
</div>

[% END %]
